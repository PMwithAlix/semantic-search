# AvalAI API key (fallback when not saved in Settings UI)
AVALAI_API_KEY=

# Encryption key for tokens stored in PostgreSQL (use a long random string)
SETTINGS_ENCRYPTION_KEY=change-me-in-production-use-32-byte-key!!

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantic_search

# Paths
UPLOAD_DIR=./uploads
EMBEDDING_MODELS_PATH=./embedding_models.json

# Limits
MAX_UPLOAD_SIZE_MB=100
# MAX_ROWS=   # optional row cap; leave unset for no limit
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=3
WORKER_POLL_INTERVAL_SECONDS=2
